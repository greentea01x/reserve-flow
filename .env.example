# ReserveFlow application. Copy this file to .env, then fill every blank secret or URL.
NODE_ENV=development
PORT=3000

# Local dev (infra/compose.yml): postgresql://rf_app:<RF_APP_PASSWORD>@127.0.0.1:5432/reserveflow
# Production (Supabase ap-southeast-1): the DIRECT connection — IPv6-only on the free tier,
# which is fine from Fly (native IPv6 egress); full session semantics (prepared statements,
# advisory locks). sslmode=verify-full needs the project CA — see apps/api/Dockerfile.
#   postgresql://rf_app:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=verify-full
DATABASE_URL=

# Production (Supabase): the Supavisor SESSION pooler on :5432 — GitHub runners are IPv4-only
# and cannot reach the direct (IPv6) host. NEVER :6543: transaction pooling breaks prepared
# statements and advisory-lock semantics (env validation rejects it at boot).
#   postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL_MIGRATE=

# One-shot canonical database initialization. Use a migrated, empty target and a direct/session
# connection with INSERT/UPDATE privileges. This deliberately never falls back to DATABASE_URL.
# Remote targets must also set the same database-side `reserveflow.environment` marker.
INITIALIZE_DATABASE_URL=
INITIALIZE_ENVIRONMENT=development
# Must equal `initialize:<database-name>` (for example initialize:reserveflow).
INITIALIZE_CONFIRM=
# Set true only for an explicitly reviewed production-like target.
INITIALIZE_ALLOW_PRODUCTION=false
# Initial login passwords (10–128 chars); admin and employee values must differ.
INITIALIZE_ADMIN_PASSWORD=
INITIALIZE_EMPLOYEE_PASSWORD=

# Dedicated disposable demo database. Its database name MUST end `_demo`, and the database
# itself MUST set `reserveflow.environment=demo` (see docs/DEMO-SEED.md). The seed requires
# this exact variable, never falls back to DATABASE_URL, and refuses any operational history.
DEMO_DATABASE_URL=

# Demo-only login credentials (10–128 chars). Existing accounts keep their current password
# hash on every rerun; these values are used only when a missing credential account is created.
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=

# Local development only. When true, authenticated booking owners can move a future booking
# into the live check-in window. Startup rejects this unless DATABASE_URL uses loopback.
DEMO_TOOLS_ENABLED=false

PUBLIC_BASE_URL=http://localhost:5173

# true behind the Fly proxy. Forwarded client IP is advisory-only — never build an IP
# allowlist on it without a separately verified trusted-proxy chain.
TRUST_PROXY=false

# Generate this independently for every environment with: openssl rand -base64 32
# Store production values in a managed secret store; never generate one at container startup.
BETTER_AUTH_SECRET=

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ReserveFlow <no-reply@reserveflow.local>
MAIL_REPLY_TO=facility@reserveflow.local
WORKER_ENABLED=true
LOG_LEVEL=debug

# Local docker compose ONLY (infra/compose.yml: postgres + mailpit). Production Postgres is
# Supabase — bootstrapped once via infra/supabase/bootstrap.sql, not these variables.
# Blank passwords are intentionally not usable defaults.
POSTGRES_DB=reserveflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
RF_OWNER_PASSWORD=
RF_APP_PASSWORD=
