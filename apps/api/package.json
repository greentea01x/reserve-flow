{
  "name": "@reserveflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:initialize": "tsx --env-file=../../.env src/db/initialize.ts",
    "db:seed:demo": "tsx --env-file=../../.env src/db/seed.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/swagger-ui": "0.6.1",
    "@node-rs/argon2": "2.1.0",
    "@reserveflow/shared": "workspace:*",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "ical-generator": "11.1.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12"
  }
}
